   "source": [
    "SELECT\n",
    "  COUNT(*) AS total_sone_form_answers,\n",
    "  SUM(CASE WHEN ce.care_epi_id IS NULL THEN 1 ELSE 0 END) AS unmatched_care_epi_rows\n",
    "FROM silver_form_answer fa\n",
    "LEFT JOIN silver_care_episode ce\n",
    "  ON fa.form_ans_care_epi_id = ce.care_epi_id\n",
    "WHERE fa.z_src_system_id = 'SONE';"
   ]
  }
